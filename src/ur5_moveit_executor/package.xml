<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur5_moveit_executor</name>
  <version>1.0.0</version>
  <description>Nodo que ejecuta trayectorias con MoveIt 2 (MoveItPy) sobre el UR5 + gripper simulado en Gazebo, usando la configuración generada con el MoveIt Setup Assistant.</description>
  <maintainer email="chaconsantiago966@users.noreply.github.com">Santiago Chacón</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>moveit_py</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>pilz_industrial_motion_planner</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ur5_robotiq_moveit_config</exec_depend>
  <exec_depend>ur5_robotiq_bringup</exec_depend>
  <exec_depend>ur5_pick_place</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
